   "source": [
    "from nltk.stem import WordNetLemmatizer"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "3e4ec065",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "rocks--> rock\n",
      "corpora--> corpus\n",
      "better: good\n"
     ]
    }
   ],
   "source": [
    "lm=WordNetLemmatizer()\n",
    "print('rocks-->',lm.lemmatize('rocks'))\n",
    "print('corpora-->',lm.lemmatize('corpora'))\n",
    "\n",
    "# pos='a' denotes adjective (POS- Parts Of Speech)\n",
    "print('better:',lm.lemmatize('better',pos='a'))"
   ]
  },
